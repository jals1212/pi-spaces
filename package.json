{
  "name": "@jals1212/pi-spaces",
  "version": "0.4.1",
  "description": "Named spaces for Pi: keep several agent homes (sign-ins, packages, settings) and pick one by name.",
  "license": "MIT",
  "author": "jals1212",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jals1212/pi-spaces.git"
  },
  "homepage": "https://github.com/jals1212/pi-spaces#readme",
  "bugs": "https://github.com/jals1212/pi-spaces/issues",
  "keywords": [
    "pi-package",
    "pi",
    "spaces",
    "profiles",
    "agent-home"
  ],
  "type": "module",
  "exports": {
    "./spaces": "./dist/spaces.js",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extensions/spaces.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "dist",
    "src",
    "extensions",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node scripts/link-self.mjs && npm run build && node --test \"tests/*.test.ts\" && npm test --prefix cli"
  },
  "devDependencies": {
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
