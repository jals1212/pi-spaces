  "description": "Named spaces for Pi: keep several agent homes (sign-ins, packages, settings) and pick one by name.",
  "license": "MIT",
  "author": "jals1212",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jals1212/pi-spaces.git"
  },
